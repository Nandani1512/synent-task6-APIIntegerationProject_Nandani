# =====================================================================
#  backend/.env.example  —  copy to backend/.env and fill in.
#  .env is gitignored: the Gemini key NEVER reaches the browser or git.
# =====================================================================

# Google Gemini API key (server-side only). Get one at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Gemini model id. Must be one your key can access — change if needed.
GEMINI_MODEL=gemini-2.5-flash

# Optional GitHub token to raise the REST rate limit (60 -> 5000/hr).
# Public data only, no scopes needed. Leave blank to run unauthenticated.
GITHUB_TOKEN=

# Port the API server listens on.
PORT=3000

# Comma-separated list of allowed CORS origins for the frontend.
# e.g. http://localhost:8000,https://yourname.github.io
CORS_ORIGINS=*
